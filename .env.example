# Copy this file to .env and populate it locally. Never commit .env.
AWS_REGION=us-east-1
PROJECT_NAME=udacity-agentcore

# Optional evidence-run overrides for labs that cannot enable the rubric's
# Marketplace-backed Claude models. Leave unset to retain the required defaults.
# ORCHESTRATOR_MODEL_ID=amazon.nova-lite-v1:0
# WORKER_MODEL_ID=amazon.nova-lite-v1:0

# Deployed resource identifiers (leave empty until deployment completes)
RETURNS_KB_ID=
SHIPPING_KB_ID=
WARRANTY_KB_ID=
GUARDRAIL_ID=
GUARDRAIL_VERSION=
AGENTCORE_RUNTIME_ARN=

# Keep false for normal use. True allows request text in X-Ray metadata.
AGENT_OBSERVABILITY_INCLUDE_SENSITIVE=false
